# ── Python ───────────────────────────────────────────────
__pycache__/
*.py[cod]
*$py.class
*.egg-info/
.eggs/
build/
dist/
.pytest_cache/
pytest-of-root/

# ── Virtual environments / secrets ───────────────────────
venv/
.venv*/
env/
ENV/
.env
.env.*
!.env.example

# ── Pipeline results / reports (generated) ───────────────
results/
results_*/
runs/
report*.json
report*.md
selectivity_*.csv
# Distribution bundles (their contents are tracked as source).
/*.zip

# ── Run and HPC job logs ─────────────────────────────────
*.log
warden_*.out
warden_*.err
slurm-*.out

# ── Caches (regenerated on demand) ───────────────────────
bulk_cache/

# ── Generated surface structures ─────────────────────────
# Amorphous slabs produced by run_surface_builder.py / run_pipeline.py.
SiO2_*.xyz
SiNx_*.xyz
*_quick_*.xyz
*_test_*.xyz
*_fast_*.xyz
*_full_*.xyz
*_prod_*.xyz
surfaces_v2/
# Inspection dumps written by `python inhibitor_library.py`.
/_*.xyz

# ── Models, external data, local configuration ───────────
models/
# Published amorphous bulks (Kim et al. / Zenodo) and their conversions.
literature/
published_xyz/
config/bond.json
config/*.local.json
examples/my-evidence.json
examples/surfaces-live.json

# ── OS / editor cruft ────────────────────────────────────
.DS_Store
Thumbs.db
.vscode/
.idea/
*.swp

# Literature loop scratch databases (evidence/ itself is tracked)
evidence/*.sqlite
evidence/*.sqlite-*
